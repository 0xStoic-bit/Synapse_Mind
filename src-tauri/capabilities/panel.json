{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Memory Panel permissions (no shell, no fs, panel-only commands)",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-memory-panel-data",
    "allow-pause-capture",
    "allow-resume-capture",
    "allow-add-blocked-app",
    "allow-remove-blocked-app",
    "allow-delete-recent-memory",
    "allow-delete-all-memory",
    "allow-open-overlay-with-query"
  ]
}
